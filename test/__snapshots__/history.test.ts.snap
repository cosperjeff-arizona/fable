// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`M3 acceptance > golden generate output, seed 1 1`] = `
"ETYMON — seed 1
Family: Proto-Gamrit (6 daughter languages, 2000 years)

Family tree:
  Proto-Gamrit  [0–100]
  ├─ (split, year 400)  [100–400]
  │  ├─ (split, year 700)  [400–700]
  │  │  ├─ Zudap  [700–2000]
  │  │  └─ Züzap  [700–2000]
  │  └─ (split, year 500)  [400–500]
  │     ├─ Zud  [500–2000]
  │     └─ (split, year 600)  [500–600]
  │        ├─ Zuda  [600–2000]
  │        └─ Zurap  [600–2000]
  └─ Zudep  [100–2000]

Sound changes by branch:
  [branch to year 400] year 400: nasal place assimilation (n > m / _labial stop; m > n / _alveolar stop)
  [branch to year 700] year 500: final devoicing (b d g v z > p t k f s / _#)
  [Zudap] year 800: total assimilation of nt > tt
  [Zudap] year 1000: intervocalic voicing (p t k > b d g / V_V)
  [Zudap] year 1500: apocope (final unstressed V > ∅ / C_#)
  [Züzap] year 900: velar palatalization (k g > tʃ dʒ / _{i,e,j,y})
  [Züzap] year 1100: intervocalic spirantization (b d g > v z h / V_V)
  [Züzap] year 1200: umlaut (a o u > e ø y before a following i/j)
  [Züzap] year 1400: fronting of u (u > y)
  [Züzap] year 2000: debuccalization of initial s (s > h / #_)
  [Zud] year 600: syncope (medial unstressed V > ∅ between single Cs)
  [Zud] year 800: final devoicing (b d g v z > p t k f s / _#)
  [Zud] year 1300: umlaut (a o u > e ø y before a following i/j)
  [Zud] year 1500: reduction of unstressed non-low vowels to schwa
  [Zud] year 1600: loss of word-final stops
  [Zud] year 1700: raising of e (e > i)
  [Zud] year 1800: rhotacism (s z > r / V_V)
  [Zud] year 2000: apocope (final unstressed V > ∅ / C_#)
  [Zuda] year 700: alveolar palatalization (t d s > tʃ dʒ ʃ / _{i,j}) (rarer variant)
  [Zuda] year 800: intervocalic voicing (p t k > b d g / V_V)
  [Zuda] year 1100: umlaut (a o u > e ø y before a following i/j)
  [Zuda] year 1300: loss of word-final stops
  [Zuda] year 1400: degemination (identical CC > C)
  [Zuda] year 1500: syncope (medial unstressed V > ∅ between single Cs)
  [Zuda] year 1800: raising of e (e > i)
  [Zurap] year 1200: intervocalic spirantization (b d g > v z h / V_V)
  [Zurap] year 1300: rhotacism (s z > r / V_V)
  [Zurap] year 1400: loss of h in all positions
  [Zurap] year 1500: syncope (medial unstressed V > ∅ between single Cs)
  [Zurap] year 1600: debuccalization of initial s (s > h / #_)
  [Zurap] year 1900: intervocalic voicing (p t k > b d g / V_V)
  [Zurap] year 2000: final devoicing (b d g v z > p t k f s / _#)
  [Zudep] year 300: fronting of a (a > e), umlaut-free systems only
  [Zudep] year 400: final devoicing (b d g v z > p t k f s / _#)
  [Zudep] year 700: nasal place assimilation (n > m / _labial stop; m > n / _alveolar stop)
  [Zudep] year 1100: intervocalic voicing (p t k > b d g / V_V)
  [Zudep] year 1200: apocope (final unstressed V > ∅ / C_#)
  [Zudep] year 1800: obstruent cluster voicing assimilation (agrees with a following obstruent)
  [Zudep] year 2000: degemination (identical CC > C)"
`;

